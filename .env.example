# ==========================================
# PUBLIC FRONTEND CLIENT CONFIGURATION
# ==========================================
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_BACKOFFICE_API_URL=https://your-project.supabase.co/functions/v1/backoffice-api-v3

# Public Telegram Bot Identifiers
VITE_TELEGRAM_BOT_USERNAME=your_bot_username
VITE_TELEGRAM_CLIENT_ID=your_telegram_client_id

# ==========================================
# SECRETS CONFIGURATION (SUPABASE SECRETS ONLY)
# Run via CLI: supabase secrets set KEY=VALUE
# DO NOT put these values in frontend .env files
# ==========================================
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CLIENT_SECRET=
# TELEGRAM_REDIRECT_URI=https://abiedienbackoffice.pages.dev/
